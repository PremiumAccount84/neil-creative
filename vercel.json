{
  "rewrites": [
    {
      "source": "/",
      "destination": "/Home.dc.html"
    },
    {
      "source": "/card",
      "destination": "/Card.dc.html"
    },
    {
      "source": "/writing",
      "destination": "/Writing.dc.html"
    },
    {
      "source": "/allison",
      "destination": "/api/allison"
    },
    {
      "source": "/allison/:page",
      "destination": "/api/allison?page=:page"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/import-writing",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/Home.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Card.dc.html",
      "destination": "/card",
      "permanent": true
    },
    {
      "source": "/Writing.dc.html",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/get-connected/:path*",
      "destination": "/#get-connected",
      "permanent": true
    },
    {
      "source": "/Allison.html",
      "destination": "/allison",
      "permanent": true
    }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/allison/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
